NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Variables privadas disponibles solo para Netlify Functions.
# Netlify Database injects NETLIFY_DB_URL automatically in production.
# Use DATABASE_URL only for a manually managed Postgres/Neon connection.
DATABASE_URL=
LEAD_HASH_SALT=
NEXUS_INGEST_URL=https://nexuschat-cgat.onrender.com/api/intake/leads
NEXUS_INGEST_SECRET=

# GROQ_API_KEY pertenece al servicio NexusChat en Render. No debe configurarse en este sitio.
